rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLifeStage(stage) {
      return stage in ['Kitten (3–12m)', 'Indoor Adult', 'Senior (7+ yrs)'];
    }

    function isValidPriorityGoal(goal) {
      return goal in ['Natural Ingredients', 'Gentle Digestion', 'Fair Daily Value'];
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'catName',
          'lifeStage',
          'priorityGoal',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'catName',
          'lifeStage',
          'priorityGoal',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.catName is string && data.catName.size() >= 1 && data.catName.size() <= 60
        && isValidLifeStage(data.lifeStage)
        && isValidPriorityGoal(data.priorityGoal)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCartLine(data, userId, productId) {
      return data.keys().hasAll(['userId', 'productId', 'quantity', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'productId', 'quantity', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.productId)
        && data.productId == productId
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 20
        && data.updatedAt is timestamp;
    }

    function isValidOrderRecord(data, userId, orderId) {
      return data.keys().hasAll([
          'orderId',
          'userId',
          'customerName',
          'city',
          'paymentMethod',
          'subtotalInr',
          'deliveryFeeInr',
          'totalInr',
          'itemsSummary',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'orderId',
          'userId',
          'customerName',
          'city',
          'paymentMethod',
          'subtotalInr',
          'deliveryFeeInr',
          'totalInr',
          'itemsSummary',
          'createdAt'
        ])
        && isValidId(data.orderId)
        && data.orderId == orderId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 60
        && data.paymentMethod in ['UPI', 'Cash on Delivery']
        && data.subtotalInr is number && data.subtotalInr > 0 && data.subtotalInr <= 100000
        && data.deliveryFeeInr is number && data.deliveryFeeInr >= 0 && data.deliveryFeeInr <= 1000
        && data.totalInr is number && data.totalInr == data.subtotalInr + data.deliveryFeeInr
        && data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 500
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'catName',
          'lifeStage',
          'priorityGoal',
          'updatedAt'
        ]);
      allow delete: if false;

      match /cart/{productId} {
        allow get: if isValidId(userId) && isValidId(productId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(productId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidCartLine(incoming(), userId, productId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(productId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidCartLine(incoming(), userId, productId)
          && incoming().userId == existing().userId
          && incoming().productId == existing().productId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(productId) && isOwner(userId);
      }

      match /orders/{orderId} {
        allow get: if isValidId(userId) && isValidId(orderId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(orderId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidOrderRecord(incoming(), userId, orderId)
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
